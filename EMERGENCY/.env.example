SECRET_KEY=change-this-to-a-long-random-string
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key
# Admin portal: service role key (Supabase > Project Settings > API) and a comma-separated admin allowlist
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
# Roles allowed to create/edit/publish/archive/delete announcements (default: admin,organization)
ANNOUNCEMENT_MANAGER_ROLES=admin,organization
# Roles allowed to use the Dispatch Center (update incidents, manage hotlines). Default: admin,organization
DISPATCH_ROLES=admin,organization
# Roles allowed to edit Agency Settings (default: organization)
AGENCY_ADMIN_ROLES=organization
# Supabase Storage bucket for profile photos and agency logos (created by supabase/migrations/005_account_settings.sql)
MEDIA_BUCKET=esrms-media

# ---- Email notifications (Resend). Leave empty to keep email delivery off.
# API key from https://resend.com/api-keys (server-side only, never sent to the browser)
RESEND_API_KEY=
# Sender on a domain you verified in Resend, e.g. ESRMS Alerts <alerts@your-domain.example>
EMAIL_FROM=
# Public URL of this ESRMS server, used for links in emails (https in production)
APP_BASE_URL=

# ---- Web push (VAPID). Generate all three with: python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach you at: mailto:you@your-domain.example
VAPID_SUBJECT=

# ---- Delivery worker (runs inside the Flask server). Set to 0 if you run scripts/deliver_notifications.py separately.
NOTIFICATION_WORKER=1
NOTIFICATION_POLL_SECONDS=5
